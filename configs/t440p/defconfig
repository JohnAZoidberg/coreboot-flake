# Base
CONFIG_VENDOR_LENOVO=y
CONFIG_BOARD_LENOVO_THINKPAD_T440P=y
CONFIG_PCIEXP_HOTPLUG=y
CONFIG_H8_SUPPORT_BT_ON_WIFI=y
CONFIG_DRIVERS_PS2_KEYBOARD=y

# Coreboot
CONFIG_TIMESTAMPS_ON_CONSOLE=y
CONFIG_USE_OPTION_TABLE=y

# Preferences
CONFIG_SECURITY_CLEAR_DRAM_ON_REGULAR_BOOT=y
CONFIG_TPM_DEACTIVATE=y
CONFIG_EDK2_DISABLE_TPM=y

# Display
CONFIG_GENERIC_LINEAR_FRAMEBUFFER=y

# Blobs
CONFIG_HAVE_ME_BIN=y
CONFIG_CHECK_ME=y
CONFIG_USE_ME_CLEANER=y
CONFIG_ME_BIN_PATH="flashregion_2_intel_me.bin"

CONFIG_HAVE_GBE_BIN=y
CONFIG_GBE_BIN_PATH="flashregion_3_gbe.bin"

CONFIG_HAVE_IFD_BIN=y
CONFIG_VALIDATE_INTEL_DESCRIPTOR=y
CONFIG_IFD_BIN_PATH="flashregion_0_flashdescriptor.bin"

CONFIG_HAVE_MRC=y
CONFIG_MRC_FILE="mrc.bin"

# UEFI
CONFIG_PAYLOAD_EDK2=y
CONFIG_EDK2_REPOSITORY="https://github.com/MrChromebox/edk2"
CONFIG_EDK2_TAG_OR_REV="78c2b10586e58b23920ec0f4d3cc1cf5fdd0b979"
CONFIG_EDK2_USE_EDK2_PLATFORMS=y
CONFIG_EDK2_FOLLOW_BGRT_SPEC=y
CONFIG_CBFS_SIZE=0x300000
